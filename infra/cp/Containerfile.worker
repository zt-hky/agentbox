# AgentBox worker (esbuild bundle). Build context: the repo root (staged by deploy.sh).
#   podman build -f infra/cp/Containerfile.worker -t localhost/agentbox-worker:latest <repo root>

FROM docker.io/library/node:24-bookworm@sha256:8544b46b91d1a8c8bf8fc0d53ae9f276ed07d0ffa9098dc4a9c2f627363a13a0 AS build
ENV CI=1 COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@12.14.0 --activate
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter '@agentbox/worker...'
RUN pnpm --filter @agentbox/worker build

FROM docker.io/library/node:24-bookworm-slim@sha256:a43f7fc3e52e87d12a905f46eea0275def84ca8f2981a5b53fed44d7fb398ee0
ENV NODE_ENV=production AGENTBOX_MIGRATIONS_DIR=/app/drizzle PORT=3001
WORKDIR /app
COPY --from=build --chown=node:node /src/apps/worker/dist/worker.mjs ./worker.mjs
COPY --from=build --chown=node:node /src/packages/db/drizzle ./drizzle
# uid 1000 inside the container. The pod uses UserNS=keep-id:uid=1000,gid=1000, which maps it to
# the host user abx-cp, the only user allowed to open /run/agentbox/agent.sock (0600 abx-cp).
USER node
EXPOSE 3001
CMD ["node", "worker.mjs"]
