[Unit]
Description=AgentBox Caddy gateway (127.0.0.1:8480)

[Container]
ContainerName=agentbox-caddy
Image=docker.io/library/caddy:2.11@sha256:04913b1da43339a40ad1ea87827d70a576ac5aa6cf674c6e24fdca675887533a
Network=host
EnvironmentFile=/var/lib/agentbox-cp/cp.env
Volume=/var/lib/agentbox-cp/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=/var/lib/agentbox-cp/landing:/srv/landing:ro
Volume=/var/lib/agentbox-cp/kcode-site:/srv/kcode:ro
DropCapability=ALL
# The caddy binary carries file capability cap_net_bind_service; exec fails without it in the set.
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
