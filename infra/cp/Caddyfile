# The plan's Caddyfile, with block bodies put on their own lines (Caddy rejects `{ directive` on
# the opening line) and the base domain taken from $AGENTBOX_BASE_DOMAIN (cp.env).
{
	admin off
	auto_https off
	servers {
		trusted_proxies static 127.0.0.1/32
		client_ip_headers CF-Connecting-IP
	}
}

# The apex serves the static marketing site built from apps/landing (published by deploy.sh).
http://{$AGENTBOX_BASE_DOMAIN}:8480 {
	bind 127.0.0.1
	root * /srv/landing
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cache-Control "no-cache"
	}
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@static path /img/* /fonts/* /favicon.svg /favicon-32.png /apple-touch-icon.png /og.png
	header @static Cache-Control "public, max-age=86400"
	file_server
}

# K-code product site + docs (static, published by t3code scripts/deploy-site.sh to $CP_HOME/kcode-site).
http://kcode.{$AGENTBOX_BASE_DOMAIN}:8480 {
	bind 127.0.0.1
	root * /srv/kcode
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cache-Control "no-cache"
	}
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@scripts path /install.sh /install.ps1
	header @scripts Content-Type "text/plain; charset=utf-8"
	file_server
}

http://app.{$AGENTBOX_BASE_DOMAIN}:8480 {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:3000
}

http://*.{$AGENTBOX_BASE_DOMAIN}:8480 {
	bind 127.0.0.1
	request_header -X-Agentbox-Upstream
	request_header -X-Gateway-Identity
	handle /__abx/* {
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		forward_auth 127.0.0.1:3001 {
			uri /internal/authorize
			copy_headers X-Agentbox-Upstream X-Gateway-Identity
		}
		request_header Cookie "(^|;\s*)__Host-abx_ws=[^;]*" ""
		reverse_proxy {http.request.header.X-Agentbox-Upstream} {
			header_up -X-Agentbox-Upstream
			transport http {
				keepalive 30s
			}
		}
	}
}
