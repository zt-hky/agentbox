--- /dev/null
+++ b/apps/server/src/auth/GatewayIdentity.ts
@@ -0,0 +1,139 @@
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- HMAC verification needs a constant-time compare.
+import * as NodeCrypto from "node:crypto";
+import * as Clock from "effect/Clock";
+import * as Config from "effect/Config";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import type * as HttpServerRequest from "effect/http/HttpServerRequest";
+
+/** A trusted gateway in front of this server signs every request it lets through. */
+export const GATEWAY_IDENTITY_HEADER = "x-gateway-identity";
+const GATEWAY_ISSUER = "agentbox";
+const CLOCK_SKEW_SECONDS = 60;
+const MIN_SECRET_BYTES = 32;
+
+export interface GatewayIdentitySettings {
+  /** HMAC-SHA256 key shared with the gateway, unique to this server. */
+  readonly secret: Buffer;
+  /** Expected `aud` claim, so a token minted for another server is refused. */
+  readonly audience: string;
+}
+
+export interface GatewayIdentityClaims {
+  readonly subject: string;
+  readonly email: string;
+}
+
+const decodeHeader = Schema.decodeUnknownOption(
+  Schema.fromJsonString(Schema.Struct({ alg: Schema.Literal("HS256") })),
+);
+const decodeClaims = Schema.decodeUnknownOption(
+  Schema.fromJsonString(
+    Schema.Struct({
+      iss: Schema.String,
+      aud: Schema.String,
+      sub: Schema.NonEmptyString,
+      email: Schema.NonEmptyString,
+      iat: Schema.Number,
+      exp: Schema.Number,
+    }),
+  ),
+);
+
+export function parseGatewayIdentitySettings(input: {
+  readonly secret: string;
+  readonly audience: string;
+}): GatewayIdentitySettings | undefined {
+  const encodedSecret = input.secret.trim();
+  const audience = input.audience.trim();
+  if (!/^[A-Za-z0-9_-]+$/u.test(encodedSecret) || audience.length === 0) return undefined;
+  const secret = Buffer.from(encodedSecret, "base64url");
+  if (secret.length < MIN_SECRET_BYTES) return undefined;
+  return { secret, audience };
+}
+
+/** Verifies a gateway token: HS256 signature, issuer, audience, and validity window. */
+export function verifyGatewayIdentityToken(
+  token: string,
+  settings: GatewayIdentitySettings,
+  nowSeconds: number,
+): GatewayIdentityClaims | undefined {
+  const [encodedHeader, encodedClaims, encodedSignature, ...rest] = token.split(".");
+  if (!encodedHeader || !encodedClaims || !encodedSignature || rest.length > 0) return undefined;
+  const header = decodeHeader(Buffer.from(encodedHeader, "base64url").toString("utf8"));
+  if (Option.isNone(header)) return undefined;
+  const expected = NodeCrypto.createHmac("sha256", settings.secret)
+    .update(`${encodedHeader}.${encodedClaims}`)
+    .digest();
+  const signature = Buffer.from(encodedSignature, "base64url");
+  if (signature.length !== expected.length || !NodeCrypto.timingSafeEqual(signature, expected)) {
+    return undefined;
+  }
+  const claims = decodeClaims(Buffer.from(encodedClaims, "base64url").toString("utf8"));
+  if (Option.isNone(claims)) return undefined;
+  const valid =
+    claims.value.iss === GATEWAY_ISSUER &&
+    claims.value.aud === settings.audience &&
+    claims.value.exp + CLOCK_SKEW_SECONDS > nowSeconds &&
+    claims.value.iat - CLOCK_SKEW_SECONDS <= nowSeconds;
+  return valid ? { subject: claims.value.sub, email: claims.value.email } : undefined;
+}
+
+export class GatewayIdentity extends Context.Service<
+  GatewayIdentity,
+  {
+    /** The verified gateway identity on this request, if any. Never fails. */
+    readonly identify: (
+      request: HttpServerRequest.HttpServerRequest,
+    ) => Effect.Effect<Option.Option<GatewayIdentityClaims>>;
+  }
+>()("t3/auth/GatewayIdentity") {}
+
+export const make = (settings: GatewayIdentitySettings) => {
+  const identify: GatewayIdentity["Service"]["identify"] = Effect.fn("GatewayIdentity.identify")(
+    function* (request) {
+      const token = request.headers[GATEWAY_IDENTITY_HEADER];
+      if (token === undefined || token.length === 0) return Option.none();
+      const nowSeconds = Math.floor((yield* Clock.currentTimeMillis) / 1_000);
+      const identity = verifyGatewayIdentityToken(token, settings, nowSeconds);
+      if (identity === undefined) {
+        yield* Effect.logWarning("rejected gateway identity token");
+        return Option.none();
+      }
+      return Option.some(identity);
+    },
+    Effect.catchCause((cause) =>
+      Effect.logWarning("Gateway identity verification failed", { cause }).pipe(
+        Effect.as(Option.none<GatewayIdentityClaims>()),
+      ),
+    ),
+  );
+  return GatewayIdentity.of({ identify });
+};
+
+const SettingsConfig = Config.all({
+  secret: Config.String("T3CODE_GATEWAY_IDENTITY_SECRET").pipe(Config.withDefault("")),
+  audience: Config.String("T3CODE_GATEWAY_IDENTITY_AUDIENCE").pipe(Config.withDefault("")),
+});
+
+/** Provides the service only when both environment variables are set and valid. */
+export const layer = Layer.unwrap(
+  Effect.gen(function* () {
+    const raw = yield* SettingsConfig;
+    const configured = [raw.secret, raw.audience].some((value) => value.trim().length > 0);
+    const settings = parseGatewayIdentitySettings(raw);
+    if (settings === undefined) {
+      if (configured) {
+        yield* Effect.logWarning(
+          "Gateway identity sign-in disabled: set T3CODE_GATEWAY_IDENTITY_SECRET (>=32 bytes base64url) and T3CODE_GATEWAY_IDENTITY_AUDIENCE",
+        );
+      }
+      return Layer.empty;
+    }
+    yield* Effect.logInfo("Gateway identity sign-in enabled", { audience: settings.audience });
+    return Layer.succeed(GatewayIdentity, make(settings));
+  }).pipe(Effect.orDie),
+);
