+// @effect-diagnostics-next-line nodeBuiltinImport:off -- Tests sign HS256 tokens like the gateway does.
+import * as NodeCrypto from "node:crypto";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { EnvironmentHttpApi } from "@t3tools/contracts";
+import { describe, expect, it } from "@effect/vitest";
+import * as Context from "effect/Context";
+import * as Crypto from "effect/Crypto";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Etag from "effect/http/Etag";
+import * as HttpPlatform from "effect/http/HttpPlatform";
+import * as HttpRouter from "effect/http/HttpRouter";
+import * as HttpApi from "effect/http-api/HttpApi";
+import * as HttpApiBuilder from "effect/http-api/HttpApiBuilder";
+
+import * as ServerConfig from "../config.ts";
+import * as ServerEnvironment from "../environment/ServerEnvironment.ts";
+import * as SqlitePersistence from "../persistence/Sqlite.ts";
+import * as EnvironmentAuth from "./EnvironmentAuth.ts";
+import * as ServerSecretStore from "./ServerSecretStore.ts";
+import * as AuthHttp from "./http.ts";
+import {
+  GATEWAY_IDENTITY_HEADER,
+  GatewayIdentity,
+  make as makeGatewayIdentity,
+  parseGatewayIdentitySettings,
+  verifyGatewayIdentityToken,
+  type GatewayIdentitySettings,
+} from "./GatewayIdentity.ts";
+
+// Shared with the AgentBox gateway's signer tests, so both sides agree byte for byte.
+const fixture = {
+  secret: "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8",
+  audience: "alice",
+  nowSeconds: 1_767_225_600,
+  token:
+    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJhZ2VudGJveCIsImF1ZCI6ImFsaWNlIiwic3ViIjoidXNlcl8xMjMiLCJlbWFpbCI6ImFsaWNlQGV4YW1wbGUuY29tIiwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjE3NjcyMjU3MjB9.W2Y8u0fjwDYkV6RQnUxRUTRi5xEw0JukHG1jw3BbLpU",
+};
+const settings = parseGatewayIdentitySettings(fixture) as GatewayIdentitySettings;
+const now = fixture.nowSeconds;
+
+function signGatewayToken(
+  claims: Record<string, unknown>,
+  input: { readonly header?: Record<string, unknown>; readonly secret?: Buffer } = {},
+): string {
+  const encode = (value: unknown) => Buffer.from(JSON.stringify(value)).toString("base64url");
+  const signingInput = `${encode(input.header ?? { alg: "HS256", typ: "JWT" })}.${encode({
+    iss: "agentbox",
+    aud: "alice",
+    sub: "user_123",
+    email: "alice@example.com",
+    iat: now,
+    exp: now + 120,
+    ...claims,
+  })}`;
+  const signature = NodeCrypto.createHmac("sha256", input.secret ?? settings.secret)
+    .update(signingInput)
+    .digest("base64url");
+  return `${signingInput}.${signature}`;
+}
+
+describe("verifyGatewayIdentityToken", () => {
+  const valid = { subject: "user_123", email: "alice@example.com" };
+  const [header, claims] = fixture.token.split(".");
+  const unsigned = `${Buffer.from(JSON.stringify({ alg: "none" })).toString("base64url")}.${claims}.`;
+
+  it.each([
+    ["the gateway's signed fixture", fixture.token, valid],
+    ["a token still inside the clock skew", signGatewayToken({ exp: now - 30 }), valid],
+    [
+      "a tampered signature",
+      `${fixture.token.slice(0, -2)}${fixture.token.endsWith("AA") ? "AB" : "AA"}`,
+      undefined,
+    ],
+    [
+      "a token signed with another secret",
+      signGatewayToken({}, { secret: Buffer.alloc(32, 7) }),
+      undefined,
+    ],
+    ["a token for another workspace", signGatewayToken({ aud: "bob" }), undefined],
+    ["another issuer", signGatewayToken({ iss: "someone-else" }), undefined],
+    ["an expired token", signGatewayToken({ exp: now - 61 }), undefined],
+    ["a token issued in the future", signGatewayToken({ iat: now + 120 }), undefined],
+    ["an empty email", signGatewayToken({ email: "" }), undefined],
+    ["alg none", unsigned, undefined],
+    [
+      "alg none with the original signature",
+      `${unsigned}${fixture.token.split(".")[2]}`,
+      undefined,
+    ],
+    [
+      "a truncated signature",
+      `${header}.${claims}.${fixture.token.split(".")[2]?.slice(0, 10)}`,
+      undefined,
+    ],
+    ["a token with an extra part", `${fixture.token}.x`, undefined],
+  ])("%s", (_name, token, expected) => {
+    expect(verifyGatewayIdentityToken(token, settings, now)).toEqual(expected);
+  });
+});
+
+describe("parseGatewayIdentitySettings", () => {
+  it("requires a base64url secret of at least 32 bytes and an audience", () => {
+    expect(
+      parseGatewayIdentitySettings({ secret: ` ${fixture.secret} `, audience: " alice " }),
+    ).toEqual(settings);
+    expect(
+      parseGatewayIdentitySettings({
+        secret: Buffer.alloc(31).toString("base64url"),
+        audience: "alice",
+      }),
+    ).toBeUndefined();
+    expect(
+      parseGatewayIdentitySettings({ secret: "not base64!", audience: "alice" }),
+    ).toBeUndefined();
+    expect(parseGatewayIdentitySettings({ secret: fixture.secret, audience: " " })).toBeUndefined();
+  });
+});
+
+class AuthTestApi extends HttpApi.make("environment").add(EnvironmentHttpApi.groups.auth) {}
+
+describe("Gateway identity sign-in", () => {
+  const layerConfig = ServerConfig.layerTest(process.cwd(), { prefix: "t3-gateway-test-" });
+  const layerRoutes = HttpApiBuilder.layer(AuthTestApi).pipe(
+    Layer.provide(
+      AuthHttp.layer.pipe(
+        Layer.provide(Layer.succeed(GatewayIdentity, makeGatewayIdentity(settings))),
+      ),
+    ),
+    Layer.provide(AuthHttp.layerAuthenticatedAuth),
+    Layer.provideMerge(
+      EnvironmentAuth.layer.pipe(
+        Layer.provide(SqlitePersistence.layerMemory),
+        Layer.provide(ServerSecretStore.layer),
+        Layer.provide(ServerEnvironment.layerIdentity),
+        Layer.provide(layerConfig),
+      ),
+    ),
+    Layer.provide(layerConfig),
+    Layer.provideMerge(
+      HttpPlatform.layer.pipe(
+        Layer.provideMerge(NodeServices.layer),
+        Layer.provideMerge(Etag.layerWeak),
+      ),
+    ),
+    Layer.provide(NodeServices.layer),
+  );
+  // An old iat and far-future exp keep the token valid under both the test and the wall clock.
+  const validClaims = { iat: 0, exp: 4_000_000_000 };
+
+  it.effect("exchanges a verified gateway identity for a browser session cookie", () =>
+    Effect.gen(function* () {
+      const crypto = yield* Crypto.Crypto;
+      const requestContext = Context.make(Crypto.Crypto, crypto).pipe(
+        Context.add(
+          ServerSecretStore.ServerSecretStore,
+          ServerSecretStore.ServerSecretStore.of({
+            get: () => Effect.succeedNone,
+            set: () => Effect.void,
+            create: () => Effect.void,
+            getOrCreateRandom: () => Effect.die("Not used by these routes."),
+            remove: () => Effect.void,
+          }),
+        ),
+      );
+      return yield* Effect.acquireUseRelease(
+        Effect.sync(() => HttpRouter.toWebHandler(layerRoutes, { disableLogger: true })),
+        (environment) =>
+          Effect.tryPromise(async () => {
+            const session = (headers: Record<string, string>) =>
+              environment.handler(
+                new Request("http://127.0.0.1/api/auth/session", { headers }),
+                requestContext,
+              );
+
+            const rejected = await session({
+              [GATEWAY_IDENTITY_HEADER]: signGatewayToken({ ...validClaims, aud: "other" }),
+            });
+            expect(await rejected.json()).toMatchObject({ authenticated: false });
+            expect(rejected.headers.getSetCookie()).toEqual([]);
+
+            const accepted = await session({
+              [GATEWAY_IDENTITY_HEADER]: signGatewayToken(validClaims),
+            });
+            expect(await accepted.json()).toMatchObject({
+              authenticated: true,
+              sessionMethod: "browser-session-cookie",
+            });
+            const cookie = accepted.headers.getSetCookie()[0]?.split(";", 1)[0] ?? "";
+            expect(cookie).toMatch(/^t3_session_/);
+
+            // The cookie alone carries the session afterwards, like a paired browser.
+            const pairing = await environment.handler(
+              new Request("http://127.0.0.1/api/auth/pairing-token", {
+                method: "POST",
+                headers: { cookie, "content-type": "application/json" },
+                body: JSON.stringify({ scopes: ["orchestration:read"] }),
+              }),
+              requestContext,
+            );
+            expect(pairing.status).toBe(200);
+          }),
+        (environment) => Effect.promise(() => environment.dispose()),
+      );
+    }).pipe(Effect.provide(NodeServices.layer)),
+  );
+});
